# Copy this file to .env and fill in your own value.
# Used to sign your login session cookie. If you don't set this, a random
# key is generated each time the server starts, which logs you out on every
# restart. Set a fixed value here so your login persists.
LEDGER_SECRET_KEY=change-this-to-any-long-random-string

# Optional: change where the SQLite database file is stored.
# LEDGER_DB_PATH=/home/you/ledger-data/ledger.db
